# Copie para .env (desenvolvimento local). Em produção, injete via variáveis do Cloud Run/Render.
APP_ENV=development
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# URL base do portal de validação (vai dentro do QR Code, sem barra final)
PUBLIC_VALIDATION_BASE_URL=http://localhost:3000/validar

# Supabase: Project Settings > Database > Connection string (URI).
# Pooler em modo transaction (porta 6543) é suportado: DB_STATEMENT_CACHE_SIZE=0.
DATABASE_URL=postgresql://postgres.PROJECT_REF:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
DB_SSL=require
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_COMMAND_TIMEOUT=30
DB_STATEMENT_CACHE_SIZE=0

# Cloudflare R2 (região "auto"). Para AWS S3 deixe S3_ENDPOINT_URL vazio e use a região real.
S3_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
# Supabase Storage (S3) exige path-style: S3_ADDRESSING_STYLE=path. Endpoint e região:
# Storage > Configuration > S3 (endpoint termina em /storage/v1/s3).
S3_ADDRESSING_STYLE=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=certificados
S3_KEY_PREFIX=certificates
S3_PRESIGNED_TTL_SECONDS=300

# Certificado A1 (Etapa 2): base64 -w0 certificado.pfx
SIGNING_PFX_BASE64=
SIGNING_PFX_PASSWORD=

# Limite de itens por requisição de lote
BATCH_MAX_ITEMS=500

# --- API de emissão em lote (Etapa 4) ---
# Chave exigida no header X-API-Key. Mínimo 32 caracteres. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Sem ela, os endpoints de emissão respondem 503. Obrigatória com APP_ENV=production.
ISSUANCE_API_KEY=
# Certificados processados ao mesmo tempo (limite global do processo)
BATCH_CONCURRENCY=4
# Corpo máximo (bytes) das requisições de lote. Mantenha < 1048576: acima disso o Starlette
# gravaria o upload do CSV em arquivo temporário, violando o "zero disco".
BATCH_MAX_BODY_BYTES=900000
# Opcional: textos gravados na assinatura PAdES (/Reason e /Location)
# SIGNING_REASON=Certificado emitido e assinado digitalmente
# SIGNING_LOCATION=Ilhéus, BA

# --- Validação pública (Etapa 5) ---
# Teto do PDF enviado em POST /validate/file. Mantenha <= 1000000: acima de 1 MiB o Starlette
# gravaria o upload em arquivo temporário, violando o "zero disco". Certificados têm dezenas de KB.
VALIDATION_MAX_UPLOAD_BYTES=1000000
# Validade da URL pré-assinada devolvida por GET /validate/{uuid}
VALIDATION_PRESIGNED_TTL_SECONDS=900
# Perícias de PDF simultâneas e tempo máximo de cada uma (segundos)
VALIDATION_CONCURRENCY=4
VALIDATION_TIMEOUT_SECONDS=20
