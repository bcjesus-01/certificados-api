# URL base da API FastAPI, sem barra final. Obrigatória no build de produção (Vercel).
# Local:    http://localhost:8000
# Produção: https://api.seudominio.com.br   (e adicione a origem do portal em CORS_ORIGINS da API)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Opcionais
# Deve ser <= VALIDATION_MAX_UPLOAD_BYTES da API (padrão 1000000)
# NEXT_PUBLIC_MAX_UPLOAD_BYTES=1000000
# Nome da instituição exibido no cabeçalho e no rodapé
# NEXT_PUBLIC_ORG_NAME=CACIC UESC
